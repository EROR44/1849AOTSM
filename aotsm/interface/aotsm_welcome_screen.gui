			name = "Decrease"
			quadTextureSprite = "GFX_scroll_up"
			position = { x = 2 y = 3 }
		}
		increaseButton = {
			name = "Increase"
			quadTextureSprite = "GFX_scroll_down"
			position = { x = -17 y = -19 }
		}
	}

	containerWindowType = {
		name = "aotsm_welcome_screen_container"
		position = { x = 0 y = 0 }
		size = { width = 1030 height = 840 }
		orientation = CENTER
		origo = center
		clipping = no
		moveable = yes

		iconType ={
			name ="welcome_screen_header_bg"
			spriteType = "GFX_category_header_long"
			position = { x= 0 y = 0 }
			Orientation = "UPPER_LEFT"
		}

		instantTextboxType = {
			name = "welcome_title"
			position = { x = -295 y = 8 }
			orientation = CENTER_UP
			font = "hoi_36header"
			borderSize = {x = 0 y = 0}
			text = welcome_title_text
			#text_color_code = H
			format = centre
			maxWidth = 600
			maxHeight = 20
			fixedsize = yes
		}

		buttonType = {
			name = "aotsm_welcome_screen_others_button"
			quadTextureSprite = "GFX_welcom_screen_others_button"
			position = { x= 14 y = 7 }
			pdx_tooltip = "aotsm_welcome_screen_others_tooltip"
			oversound = ui_menu_over
		}

		buttonType = { #CLOSE_BUTTON
			name = "close_button"
			position = { x = -38 y = 6 }
			orientation = UPPER_RIGHT

			quadTextureSprite = "GFX_closebutton"
			clicksound = click_close
			pdx_tooltip = "CLOSE"

			shortcut = "ESCAPE"
			shortcut = "RETURN"
			shortcut = "SPACE"
		}
	}

