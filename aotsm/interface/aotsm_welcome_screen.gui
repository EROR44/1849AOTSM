guiTypes = {
	extendedScrollbarType = {
		name = "aotsm_welcome_buttons_slider"
		position = { x = -6 y = 0 }
		size = { width = 18 height = 18 }
		startValue = 0
		orientation = upper_right
		origo = upper_right
