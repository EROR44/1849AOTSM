guiTypes = {

	containerWindowType = {
		name = "aotsm_city_info_window"
		position = { x = 18 y = 10 }
		size = { width = 32 height = 32 }

		buttonType = {
			name = "aotsm_city_info_open"
			position = { x = 0 y = 0 }
			spriteType = "GFX_aotsm_city_button"
			scale = 0.35
			pdx_tooltip = "aotsm_city_info_open_tt"
			clicksound = click_default
		}
	}

	containerWindowType = {
		name = "aotsm_city_info_panel"
		position = { x = -205 y = -260 }
		orientation = center
		size = { width = 546 height = 480 }
		moveable = yes
		click_to_front = yes
		clipping = yes

		background = { 
			name = "background" 
			quadTextureSprite = "GFX_tiled_paper_w_frame_bg" 
		}			

		iconType ={
			name ="aotsm_demography_title_header"
			spriteType = "GFX_header_bg"
			position = { x= 4 y = 2 }
			Orientation = "UPPER_LEFT" 
		}

		buttonType = {
			name = "aotsm_city_info_close"
			position = { x = 507 y = 5 }
			orientation = upper_left
			quadTextureSprite = "GFX_closebutton"
			pdx_tooltip = "aotsm_city_info_close_tt"
			shortcut = "ESCAPE"
			clicksound = click_close
			pdx_tooltip = "CLOSE"
		}

		instantTextboxType = {
			name = "aotsm_city_title"
			position = { x = 24 y = 9 }
			orientation = upper_left
			font = "hoi_24header"
			text = "aotsm_city_info_title_t"
			maxWidth = 345
			maxHeight = 30
			format = left
			fixedsize = yes
			alwaystransparent = no
			pdx_tooltip = "aotsm_city_info_date_tt"
		}

		instantTextboxType = {
			name = "aotsm_city_body"
			position = { x = 24 y = 48 }
			orientation = upper_left
			font = "hoi_16mbs"
			text = "[aotsm_city_info_body_t]"
			maxWidth = 500
			maxHeight = 365
			format = left
			fixedsize = yes
			alwaystransparent = yes
		}

		iconType = {
			name = "aotsm_city_info_backdrop"
			position = { x = 24 y = 372 }
			orientation = upper_left
			spriteType = "GFX_terrain_urban"
			alwaystransparent = yes
			scale = 1.2
		}
	}
}
